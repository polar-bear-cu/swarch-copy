{
  "name": "copy",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "services/gateway",
    "services/auth",
    "services/room"
  ],
  "scripts": {
    "postinstall": "node scripts/postinstall.ts",
    "format": "prettier --write . && gofmt -w services/code-runner services/collab && echo [code-runner, collab] gofmt done",
    "format:check": "prettier --check . && node scripts/check-gofmt.ts",
    "lint": "npm --prefix frontend run lint && npm --prefix services/gateway run lint && npm --prefix services/auth run lint && npm --prefix services/room run lint && cd services/code-runner && go vet ./... && cd ../collab && go vet ./... && cd ../.. && echo [code-runner, collab] go vet OK",
    "prepare": "husky",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:gateway": "npm --prefix services/gateway run dev",
    "dev:auth": "npm --prefix services/auth run dev",
    "dev:room": "npm --prefix services/room run dev",
    "dev:code-runner": "cd services/code-runner && air",
    "dev:collab": "cd services/collab && air"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/node": "^26.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.3.3",
    "typescript": "^6.0.3"
  },
  "lint-staged": {
    "frontend/**/*.{ts,tsx}": [
      "npm --prefix frontend run lint -- --fix"
    ],
    "services/gateway/**/*.ts": [
      "npm --prefix services/gateway run lint -- --fix"
    ],
    "services/auth/**/*.ts": [
      "npm --prefix services/auth run lint -- --fix"
    ],
    "services/room/**/*.ts": [
      "npm --prefix services/room run lint -- --fix"
    ],
    "services/code-runner/**/*.go": [
      "gofmt -w"
    ],
    "services/collab/**/*.go": [
      "gofmt -w"
    ],
    "**/*.{ts,tsx,js,jsx,json,css,md}": [
      "prettier --write"
    ]
  }
}
